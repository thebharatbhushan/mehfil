# Cloudflare dashboard -> Workers & Pages -> mehfil -> Settings -> Build -> Variables and secrets
# NEXT_PUBLIC_* values are inlined at BUILD time, so add them as *Build* variables (not only runtime).

# Your final public URL (workers.dev or custom domain), no trailing slash. Used for canonical, sitemap, robots, OG.
NEXT_PUBLIC_SITE_URL=https://mehfil.<your-subdomain>.workers.dev
NEXT_PUBLIC_API_URL=https://mehfilbackend-lhfl.onrender.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
